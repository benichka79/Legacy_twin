# Copy to .env and adjust. Everything runs with the defaults + mocks (no API keys needed).

DATABASE_URL=postgres://legacy:legacy@localhost:5434/legacy_twin

# Where original media lands (immutable, content-addressed). Swapped for S3 later.
VAULT_DIR=./data/vault

# Adapters: "mock" needs no keys. Switch per capability when you have keys.
LLM_PROVIDER=mock            # mock | anthropic
ASR_PROVIDER=mock            # mock | deepgram
EMBED_PROVIDER=mock          # mock | voyage (semantic retrieval; mock = lexical hashing)

# Only needed when the matching provider above is enabled.
ANTHROPIC_API_KEY=
DEEPGRAM_API_KEY=
VOYAGE_API_KEY=

# Model overrides (defaults shown)
GEN_MODEL=claude-sonnet-5
VERIFY_MODEL=claude-haiku-4-5-20251001
# Deepgram model for ASR (try nova-2 if nova-3 is unavailable on your account)
ASR_MODEL=nova-3
# Voyage embedding model (1024-dim; changing dimension requires re-embedding)
EMBED_MODEL=voyage-3.5
